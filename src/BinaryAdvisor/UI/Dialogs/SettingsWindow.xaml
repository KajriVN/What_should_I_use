<Window x:Class="BinaryAdvisor.UI.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt Đường dẫn Công cụ — Tool Path Manager"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dialog Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="⚙ Quản lý Đường dẫn Công cụ (Tool Path Manager)"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Cấu hình vị trí thực tế của diec.exe và bộ công cụ phân tích trên máy. Chấm tròn Xanh báo sẵn sàng, Đỏ báo chưa tìm thấy tệp."
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔍 Tự động dò (Auto-Detect)"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,8,0"
                        Click="BtnAutoDetect_Click" />
                <Button Content="＋ Thêm công cụ"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnAddTool_Click" />
            </StackPanel>
        </Grid>

        <!-- Core Scanner Section: diec.exe -->
        <Border Grid.Row="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                    <Ellipse x:Name="DiecStatusDot"
                             Width="11"
                             Height="11"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Công cụ lõi: Detect It Easy CLI (diec.exe)"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="TxtDiecStatus"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtDiecPath"
                             Style="{StaticResource DarkTextBoxStyle}"
                             FontFamily="{StaticResource MonoFont}"
                             TextChanged="TxtDiecPath_TextChanged" />

                    <Button Grid.Column="1"
                            Content="📂 Browse..."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="BtnBrowseDiec_Click" />

                    <Button Grid.Column="2"
                            Content="⚡ Test diec"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="BtnTestDiec_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Column Headers + Counter -->
        <Grid Grid.Row="2" Margin="6,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="158" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="TÊN CÔNG CỤ / KEY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Grid.Column="2" Text="LOẠI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Grid.Column="3" Text="ĐƯỜNG DẪN THỰC THI (.EXE / .BAT)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Grid.Column="4" Text="THAM SỐ MẪU ({file}, {file_dir}...)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock x:Name="TxtReadyCounter" Grid.Column="5" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" />
        </Grid>

        <!-- Scrollable Tool List -->
        <Border Grid.Row="3"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ScrollViewer x:Name="ToolsScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ToolsRowsPanel" />
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtConfigFileHint"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource TextMutedBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Hủy"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="90"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click" />
                <Button Content="💾 Lưu cấu hình"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="145"
                        Click="BtnSave_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
