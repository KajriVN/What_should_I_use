<UserControl x:Class="BinaryAdvisor.UI.Controls.ToolCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,10">
    <Border x:Name="CardRoot"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            MouseLeftButtonDown="CardRoot_MouseLeftButtonDown"
            Cursor="Hand">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#48525E" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <!-- Top Row: Status Dot + Name + Type Badge + Rule Tag -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="10"
                             Height="10"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtToolName"
                               FontSize="14.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Border x:Name="TypeBadge"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTypeBadge"
                                   FontSize="10.5"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="TxtInstallState"
                               FontSize="11.5"
                               VerticalAlignment="Center" />
                </WrapPanel>

                <Border Grid.Column="1"
                        Background="#21262D"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="7,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRuleBadge"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>

            <!-- Recommendation Reason -->
            <TextBlock x:Name="TxtReason"
                       Margin="0,8,0,0"
                       FontSize="13"
                       LineHeight="19"
                       Foreground="#C9D1D9"
                       TextWrapping="Wrap" />

            <!-- Optional Warning Callout -->
            <Border x:Name="WarningBox"
                    Visibility="Collapsed"
                    Margin="0,8,0,0"
                    Background="#292112"
                    BorderBrush="{StaticResource WarningAmberBrush}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="4"
                    Padding="10,7">
                <TextBlock x:Name="TxtWarning"
                           FontSize="12"
                           LineHeight="17.5"
                           Foreground="#E3B341"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Command Preview Pill -->
            <Border Margin="0,9,0,0"
                    Background="#0D1117"
                    BorderBrush="#262C36"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,5">
                <TextBlock x:Name="TxtCommandPreview"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11.5"
                           Foreground="#79C0FF"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Action Buttons -->
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BtnPrimaryAction"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        Click="BtnPrimaryAction_Click" />

                <Button x:Name="BtnCopyCmd"
                        Content="📋 Copy Command"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,5"
                        Margin="0,0,8,0"
                        Click="BtnCopyCmd_Click" />

                <Button Content="⌨ Đưa xuống Drawer"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,5"
                        Click="BtnSelectDrawer_Click" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
