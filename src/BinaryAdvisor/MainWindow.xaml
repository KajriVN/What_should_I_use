<Window x:Class="BinaryAdvisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Binary Advisor — Reverse Engineering Triage &amp; Launcher"
        Width="1380"
        Height="880"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Loaded="Window_Loaded">

    <Grid>
        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <!-- Vùng 1: Top Bar (App Header + Drag & Drop & File Metadata) -->
                <RowDefinition Height="Auto" />
                <!-- Main Workspace (Vùng 2 Left + Vùng 3 Right) -->
                <RowDefinition Height="*" MinHeight="280" />
                <!-- Horizontal Splitter -->
                <RowDefinition Height="8" />
                <!-- Vùng 4: Bottom CLI Launcher & Log Drawer -->
                <RowDefinition Height="215" MinHeight="145" />
            </Grid.RowDefinitions>

            <!-- =============================================================== -->
            <!-- VÙNG 1: THANH KÉO THẢ & THÔNG TIN TỆP (TOP BAR)                  -->
            <!-- =============================================================== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <!-- App Title & Quick Toolbar -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1F6FEB"
                                CornerRadius="7"
                                Width="34"
                                Height="34"
                                Margin="0,0,11,0">
                            <TextBlock Text="BA"
                                       FontWeight="ExtraBold"
                                       FontSize="14.5"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BINARY ADVISOR"
                                           FontSize="16.5"
                                           FontWeight="ExtraBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border x:Name="DiecStatusPill"
                                        Background="#21262D"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="9,2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="DiecStatusPill_Click"
                                        ToolTip="Bấm để mở Cài đặt đường dẫn công cụ (Settings)">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TopDiecDot"
                                                 Width="8"
                                                 Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtTopDiecState"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="What Should I Use? — Định danh nhị phân, cảnh báo Packer/Entropy &amp; điều phối công cụ dịch ngược"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📂 Browse File..."
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="0,0,8,0"
                                Click="BtnBrowseFile_Click" />
                        <Button x:Name="BtnRescan"
                                Content="🔄 Quét lại"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Margin="0,0,8,0"
                                Click="BtnRescan_Click" />
                        <Button Content="⚙ Settings (Tool Paths)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnOpenSettings_Click" />
                    </StackPanel>
                </Grid>

                <!-- Drag & Drop + File Info Card -->
                <Border x:Name="DropZoneBorder"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1.5"
                        CornerRadius="9"
                        Padding="14,11">
                    <Grid>
                        <!-- Empty State Prompt -->
                        <Grid x:Name="EmptyDropPrompt" Visibility="Visible">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <TextBlock Text="📥" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Kéo &amp; thả tệp nhị phân (.exe, .dll, .sys, ELF, bộ cài đặt...) vào cửa sổ này để phân tích ngay"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Hoặc bấm nút 'Browse File...' ở góc phải phía trên • Hỗ trợ đường dẫn tiếng Việt &amp; tệp dung lượng lớn (> 100 MB)"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Populated File Metadata Panel -->
                        <Grid x:Name="FileMetadataPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <!-- Format Badge -->
                            <Border Grid.Column="0"
                                    Background="#182C46"
                                    BorderBrush="#388BFD"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="14,8"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ĐỊNH DẠNG"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="#79C0FF"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtFileFormatBadge"
                                               Text="PE64"
                                               FontSize="16"
                                               FontWeight="ExtraBold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Name, Path & Size -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFileName"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,10,0" />
                                    <Border Background="#21262D"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtFileSize"
                                                   FontSize="11.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="#7EE787" />
                                    </Border>
                                    <TextBlock x:Name="TxtScanTime"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </WrapPanel>
                                <TextBlock x:Name="TxtFileFullPath"
                                           FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- MD5 & SHA256 Hashes -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MD5:"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtMd5"
                                               Grid.Column="1"
                                               FontSize="11.5"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="#D2A8FF"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Content="Copy"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="7,2"
                                            FontSize="10.5"
                                            Margin="6,0,0,0"
                                            Click="BtnCopyMd5_Click" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SHA-256:"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSha256"
                                               Grid.Column="1"
                                               FontSize="11.5"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="#79C0FF"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Content="Copy"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="7,2"
                                            FontSize="10.5"
                                            Margin="6,0,0,0"
                                            Click="BtnCopySha256_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Async Loading Progress Strip -->
                <Border x:Name="ScanLoadingBar"
                        Visibility="Collapsed"
                        Background="#14233A"
                        BorderBrush="#2F81F7"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7"
                        Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True"
                                     Height="6"
                                     Background="#0D1117"
                                     Foreground="#388BFD"
                                     BorderThickness="0"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtScanProgressStatus"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   Foreground="#A5D6FF"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="Hủy"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,2"
                                FontSize="11"
                                Click="BtnCancelScan_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- =============================================================== -->
            <!-- WORKSPACE GIỮA: VÙNG 2 (TRÁI) & VÙNG 3 (PHẢI)                    -->
            <!-- =============================================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Vùng 2: Bảng Kết quả DIE & Thanh Entropy -->
                    <ColumnDefinition Width="390" MinWidth="300" />
                    <ColumnDefinition Width="10" />
                    <!-- Vùng 3: Luồng Khuyến nghị Công cụ (3 Bước) -->
                    <ColumnDefinition Width="*" MinWidth="460" />
                </Grid.ColumnDefinitions>

                <!-- VÙNG 2: LEFT PANEL (DIE TREE + ENTROPY BARS) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="1.15*" />
                    </Grid.RowDefinitions>

                    <!-- DIE Detections TreeView Card -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="🔎 Kết quả Nhận diện (DIE Tree)"
                                           FontSize="13.5"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="TxtDetectSourceBadge"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border x:Name="ScannerNoticeBox"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    Background="#251F13"
                                    BorderBrush="#D29922"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,5"
                                    Margin="0,0,0,7">
                                <TextBlock x:Name="TxtScannerNotice"
                                           FontSize="11"
                                           Foreground="#E3B341"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TreeView x:Name="DieTreeView"
                                      Grid.Row="2"
                                      Background="#0D1117"
                                      BorderBrush="#262C36"
                                      BorderThickness="1"
                                      Padding="6" />
                        </Grid>
                    </Border>

                    <!-- Section Entropy Card -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="📊 Thanh Entropy &amp; Phân vùng (&gt; 7.2 Cảnh báo)"
                                           FontSize="13.5"
                                           FontWeight="Bold" />
                                <Border x:Name="PackStatusBadge"
                                        HorizontalAlignment="Right"
                                        Background="#21262D"
                                        CornerRadius="4"
                                        Padding="7,2">
                                    <TextBlock x:Name="TxtPackStatus"
                                               Text="CHƯA QUÉT"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <!-- Total Entropy Summary Bar -->
                            <Border Grid.Row="1"
                                    Background="#0D1117"
                                    BorderBrush="#262C36"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="9,7"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Tổng Entropy toàn tệp (Total Entropy)"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="TxtTotalEntropy"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Text="0.00 / 8.00" />
                                    </Grid>
                                    <ProgressBar x:Name="BarTotalEntropy"
                                                 Minimum="0"
                                                 Maximum="8"
                                                 Value="0"
                                                 Height="7"
                                                 Background="#21262D"
                                                 Foreground="{StaticResource SuccessGreenBrush}"
                                                 BorderThickness="0" />
                                </StackPanel>
                            </Border>

                            <!-- Per-Section Entropy List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SectionsEntropyPanel">
                                    <TextBlock Text="Thả tệp vào ứng dụng để xem điểm Entropy chi tiết của từng Section (.text, .rdata, .rsrc, Overlay...)"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="4,8" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Vertical Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- VÙNG 3: CENTER / RIGHT PANEL (3-STEP TOOL RECOMMENDATION WORKFLOW) -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧭 Luồng Khuyến nghị Công cụ (3-Step Triage Pipeline)"
                                           FontSize="14.5"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMatchedRulesCount"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,10,0" />
                                <Button Content="＋ Tự thêm Tool"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4"
                                        FontSize="11.5"
                                        ToolTip="Thêm công cụ phân tích tùy chỉnh (ví dụ: ReactorSlayer, ExtremeDumper, jadx...) và gán quy tắc gợi ý tự động"
                                        Click="BtnQuickAddCustomTool_Click" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="WorkflowContainer">
                                <!-- Heuristic Alert Banner (Suspected Custom Packer) -->
                                <Border x:Name="HeuristicAlertBanner"
                                        Visibility="Collapsed"
                                        Background="#341619"
                                        BorderBrush="{StaticResource DangerRedBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="13,10"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtHeuristicTitle"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="#FF7B72" />
                                        <TextBlock x:Name="TxtHeuristicDetails"
                                                   FontSize="12.5"
                                                   LineHeight="18"
                                                   Foreground="#FFA198"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Strategy Summary Callout -->
                                <Border x:Name="StrategySummaryBox"
                                        Visibility="Collapsed"
                                        Background="#13233A"
                                        BorderBrush="#2F81F7"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="13,10"
                                        Margin="0,0,0,14">
                                    <TextBlock x:Name="TxtStrategySummary"
                                               FontSize="13"
                                               LineHeight="19"
                                               Foreground="#CAE8FF"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Initial Welcome Placeholder -->
                                <Border x:Name="WelcomePlaceholder"
                                        Background="#12161C"
                                        BorderBrush="#262C36"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,28"
                                        Margin="0,8,0,0">
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="540">
                                        <TextBlock Text="Sẵn sàng tư vấn công cụ Dịch ngược &amp; Phân tích Mã độc"
                                                   FontSize="15.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Khi bạn kéo thả một tệp nhị phân vào cửa sổ, Binary Advisor sẽ tự động đối chiếu kết quả nhận diện (Installer/SFX → Packer/Protector → Compiler/Ngôn ngữ) kết hợp kiểm tra Heuristic Entropy để đề xuất đúng bộ công cụ theo 3 bước chuẩn:"
                                                   FontSize="12.5"
                                                   LineHeight="19"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,8,0,14" />
                                        <WrapPanel HorizontalAlignment="Center">
                                            <Border Background="#1D2633" CornerRadius="6" Padding="10,6" Margin="4">
                                                <TextBlock Text="1️⃣ Unpack / Extract" FontSize="12" FontWeight="SemiBold" Foreground="#FFA657" />
                                            </Border>
                                            <Border Background="#1D2633" CornerRadius="6" Padding="10,6" Margin="4">
                                                <TextBlock Text="2️⃣ Phân tích tĩnh (Static)" FontSize="12" FontWeight="SemiBold" Foreground="#79C0FF" />
                                            </Border>
                                            <Border Background="#1D2633" CornerRadius="6" Padding="10,6" Margin="4">
                                                <TextBlock Text="3️⃣ Phân tích động (Dynamic)" FontSize="12" FontWeight="SemiBold" Foreground="#D2A8FF" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3-Step Pipeline Sections -->
                                <StackPanel x:Name="StepsPipelinePanel" Visibility="Collapsed">
                                    <!-- STEP 1 -->
                                    <Border Background="#14181F"
                                            BorderBrush="#262C36"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="#3B2313" CornerRadius="5" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Text="BƯỚC 1" FontSize="11" FontWeight="ExtraBold" Foreground="#FFA657" />
                                                </Border>
                                                <TextBlock Text="Unpack / Extract (Bung gói cài đặt &amp; Giải nén Packer)"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FFA657"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="Step1CardsHost" />
                                        </StackPanel>
                                    </Border>

                                    <!-- STEP 2 -->
                                    <Border Background="#14181F"
                                            BorderBrush="#262C36"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="#142946" CornerRadius="5" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Text="BƯỚC 2" FontSize="11" FontWeight="ExtraBold" Foreground="#79C0FF" />
                                                </Border>
                                                <TextBlock Text="Phân tích tĩnh (Static Analysis — Decompiler / Disassembler / Triage)"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="#79C0FF"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="Step2CardsHost" />
                                        </StackPanel>
                                    </Border>

                                    <!-- STEP 3 -->
                                    <Border Background="#14181F"
                                            BorderBrush="#262C36"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="#291B42" CornerRadius="5" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Text="BƯỚC 3" FontSize="11" FontWeight="ExtraBold" Foreground="#D2A8FF" />
                                                </Border>
                                                <TextBlock Text="Phân tích động (Dynamic Analysis — Debugger / Memory Dump / Monitor)"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="#D2A8FF"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="Step3CardsHost" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Horizontal Splitter for Bottom Drawer -->
            <GridSplitter Grid.Row="2"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- =============================================================== -->
            <!-- VÙNG 4: TRÌNH KHỞI CHẠY & DÒNG LỆNH (BOTTOM DRAWER)              -->
            <!-- =============================================================== -->
            <Border Grid.Row="3"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Command Bar & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnQuickSelectTool"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,5"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="Bấm để chọn nhanh bất kỳ công cụ nào trong danh sách (kể cả khi không khớp quy tắc tự động)"
                                Click="BtnQuickSelectTool_Click">
                            <TextBlock x:Name="TxtActiveDrawerTool"
                                       Text="⚡ Chọn Tool ▾"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#79C0FF" />
                        </Button>

                        <TextBox x:Name="TxtCommandLine"
                                 Grid.Column="1"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="12"
                                 Margin="0,0,8,0"
                                 ToolTip="Câu lệnh thực thi đã điền sẵn đường dẫn tệp (bạn có thể chỉnh sửa thêm cờ tham số trước khi bấm Run CLI)" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="📋 Copy Command"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,6,0"
                                    Click="BtnDrawerCopy_Click" />
                            <Button x:Name="BtnDrawerRunCli"
                                    Content="▶ Run CLI"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,6,0"
                                    Click="BtnDrawerRunCli_Click" />
                            <Button x:Name="BtnDrawerOpenGui"
                                    Content="🚀 Open in Tool"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Margin="0,0,6,0"
                                    Click="BtnDrawerOpenGui_Click" />
                            <Button Content="🗑 Clear"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="9,6"
                                    Click="BtnClearLog_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Output Terminal Log -->
                    <TextBox x:Name="TxtTerminalLog"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#090C10"
                             Foreground="#C9D1D9"
                             BorderBrush="#262C36"
                             BorderThickness="1"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="11.5"
                             Padding="10,8"
                             VerticalContentAlignment="Top"
                             Text="[Binary Advisor Console] Sẵn sàng. Kéo thả tệp vào ứng dụng để phân tích hoặc chọn một thẻ công cụ để khởi chạy." />
                </Grid>
            </Border>
        </Grid>

        <!-- Drag & Drop Full-Window Visual Overlay -->
        <Border x:Name="DragOverlay"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Background="#BF0D1117"
                BorderBrush="#388BFD"
                BorderThickness="3"
                CornerRadius="10"
                Margin="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📥" FontSize="44" HorizontalAlignment="Center" />
                <TextBlock Text="Thả tệp vào đây để quét bằng Binary Advisor"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           Margin="0,10,0,4" />
                <TextBlock Text="Tự động băm MD5/SHA-256, quét chữ ký DIE, tính Entropy từng Section &amp; gợi ý công cụ"
                           FontSize="13"
                           Foreground="#79C0FF"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
